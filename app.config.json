{
  "$schema": "./schemas/app-config.schema.json",
  "name": "JSONL Viewer",
  "nameJa": "JSONL Viewer",
  "slug": "jsonl-viewer",
  "version": "1.0.0",
  "description": "Open JSONL and NDJSON files locally, inspect records, find invalid lines, and review field types.",
  "descriptionJa": "JSONL / NDJSONファイルをブラウザー内で開き、レコード・不正行・フィールド構成・型の混在を確認します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-jsonl-viewer"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 10,
      "selfExtractWarningMb": 6
    }
  }
}
